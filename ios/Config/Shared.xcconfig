// Signing: put your team in Config/Local.xcconfig (gitignored), e.g.
//   DEVELOPMENT_TEAM = ABCDE12345

// Set // Bundle ID of the app; the widget extension and tests append a suffix, the App Group is group.<this>.
// Set your own in Local.xcconfig.
IA_BUNDLE_ID = com.example.esp32agent

// Set IA_ENTITLEMENTS = IPhoneAgent/IPhoneAgent.entitlements in Local.xcconfig
// once Xcode is signed in, to enable one-tap joining of the board's hotspot.
IA_ENTITLEMENTS =
// For a paid-team App Store trial build, explicitly choose IPhoneAgent/Trial.entitlements
// (App Attest only) or IPhoneAgent/IPhoneAgent.entitlements (Hotspot/App Groups too).
// Personal Team / unsigned builds keep BYOK available and the free trial fails closed.
// Also set IA_WIDGET_ENTITLEMENTS = AgentActivity/AgentActivity.entitlements so the widgets share the App Group.
IA_WIDGET_ENTITLEMENTS =

// Optional LLM preset for your own builds, set in Local.xcconfig (write "//" as "/$()/"):
//   IA_PRESET_BASE_URL = https:/$()/example.com/v1
IA_PRESET_BASE_URL =
IA_PRESET_MODEL =
IA_PRESET_KEY =

// App Store builds use production App Attest; a signed development build may override this.
IA_APP_ATTEST_ENVIRONMENT = production

#include? "Local.xcconfig"
